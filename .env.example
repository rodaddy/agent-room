# Local app
APP_ENV=local
APP_ORIGIN=http://localhost:3000
WEB_PORT=3000
ORCHESTRATOR_PORT=4000
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_WS_URL=ws://127.0.0.1:4000/rooms/demo

# Local/basic auth/session for MVP. Values are examples only.
# Unauthenticated WebSocket upgrades are allowed only on loopback by default.
BASIC_AUTH_USER=local
BASIC_AUTH_PASSWORD=change-me
SESSION_SECRET=change-me-local-session-secret
ORCHESTRATOR_LOCAL_TOKEN=
ALLOW_UNAUTHENTICATED_LOCAL=1

# Logging and diagnostics
LOG_LEVEL=info
TEST_LOGS=0
METRICS_ENABLED=true

# Optional provider adapters. Empty means mock/degraded provider mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=
LITELLM_BASE_URL=
LITELLM_API_KEY=
LOCAL_MODEL_BASE_URL=

# Optional voice providers. Empty means mock/degraded provider mode.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
STT_PROVIDER=mock
TTS_PROVIDER=mock
VOICE_ROOM_PROVIDER=mock

# Future persistence/handoff. Empty means in-memory/local fixture mode.
DATABASE_URL=
REDIS_URL=
HERMES_HANDOFF_URL=
DISCORD_WEBHOOK_URL=
