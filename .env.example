# Local app
APP_ENV=local
APP_ORIGIN=http://localhost:3000
WEB_PORT=3000
ORCHESTRATOR_PORT=4000
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_WS_URL=ws://127.0.0.1:4000/rooms/demo
VITE_ORCHESTRATOR_WS_URL=ws://127.0.0.1:4000/rooms/demo
VITE_ORCHESTRATOR_HTTP_URL=http://127.0.0.1:4000

# Local/basic auth/session for MVP. Values are examples only.
# Unauthenticated WebSocket upgrades are allowed only on loopback by default.
BASIC_AUTH_USER=local
BASIC_AUTH_PASSWORD=change-me
SESSION_SECRET=change-me-local-session-secret
ORCHESTRATOR_LOCAL_TOKEN=
ALLOW_UNAUTHENTICATED_LOCAL=1
LLM_PROVIDER_TIMEOUT_MS=30000
AGENT_ROOM_DB_PATH=data/agent-room.sqlite
AGENT_ROOM_ARTIFACT_DIR=data/artifacts
AGENT_ROOM_PERSONA_ROOT=/Volumes/collab/agent-backups/agents
AGENT_ROOM_ADMIN_KEY_REF=vaultwarden://agent-room/admin-api-key
AGENT_ROOM_ORCHESTRATOR_TOKEN_REF=vaultwarden://agent-room/orchestrator-local-token

# Logging and diagnostics
LOG_LEVEL=info
TEST_LOGS=0
METRICS_ENABLED=true

# Optional provider adapters. Empty means mock/degraded provider mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=
LITELLM_BASE_URL=
LITELLM_API_KEY=
LOCAL_MODEL_BASE_URL=

# Optional voice providers. Empty means mock/degraded provider mode.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
STT_PROVIDER=mock
TTS_PROVIDER=mock
VOICE_ROOM_PROVIDER=mock
LIVE_VOICE_PROVIDERS_ENABLED=0

# Future handoff. Empty means local fixture mode.
DATABASE_URL=
REDIS_URL=
HERMES_HANDOFF_URL=
DISCORD_WEBHOOK_URL=
